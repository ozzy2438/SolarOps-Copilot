        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "assessed_on": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractedField_date_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "assessor_name": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractedField_str_"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Staff name. Redacted before third-party calls."
    },
    "battery_space_available": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractedField_bool_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "document_type": {
      "$ref": "#/$defs/DocumentType",
      "default": "site_assessment"
    },
    "existing_pv_kw": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractedField_float_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hazards": {
      "description": "Asbestos, height, live parts, restricted access.",
      "items": {
        "$ref": "#/$defs/ExtractedField_str_"
      },
      "title": "Hazards",
      "type": "array"
    },
    "main_switch_rating_a": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractedField_float_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
