    "nmi": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractedField_str_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parser_warnings": {
      "items": {
        "type": "string"
      },
      "title": "Parser Warnings",
      "type": "array"
    },
    "phase_configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractedField_PhaseConfiguration_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
