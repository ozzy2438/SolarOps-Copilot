        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "roof_planes": {
      "items": {
        "$ref": "#/$defs/RoofPlane"
      },
      "title": "Roof Planes",
      "type": "array"
    },
    "site_address": {
      "$ref": "#/$defs/ExtractedField_str_"
    },
    "switchboard_notes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractedField_str_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "provenance",
    "site_address"
  ],
  "title": "ExtractedSiteAssessment",
  "type": "object"
}
