    "PhaseConfiguration": {
      "enum": [
        "single_phase",
        "three_phase",
        "unknown"
      ],
      "title": "PhaseConfiguration",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a record came from. Attached to everything written to the CRM.",
      "properties": {
        "document_id": {
          "description": "Primary key of the source row in app.documents.",
          "title": "Document Id",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "sha256": {
          "description": "Hash of the source bytes.",
          "maxLength": 64,
          "minLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "tier": {
          "description": "'A' for real, publicly sourced material; 'B' for synthetic. See docs/DATA_SOURCES.md. Synthetic records must never be reported as real.",
          "pattern": "^[AB]$",
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "sha256",
        "ingested_at",
        "tier"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RoofOrientation": {
      "enum": [
        "N",
        "NE",
        "E",
        "SE",
        "S",
        "SW",
        "W",
        "NW",
        "flat",
        "mixed"
      ],
      "title": "RoofOrientation",
      "type": "string"
    },
    "RoofPlane": {
      "additionalProperties": false,
      "description": "One usable roof plane. A commercial site typically has several.",
      "properties": {
        "orientation": {
          "$ref": "#/$defs/ExtractedField_RoofOrientation_"
        },
        "shading_notes": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractedField_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tilt_degrees": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractedField_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 = flat, 90 = vertical."
        },
        "usable_area_m2": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractedField_float_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "orientation"
      ],
      "title": "RoofPlane",
      "type": "object"
    }
