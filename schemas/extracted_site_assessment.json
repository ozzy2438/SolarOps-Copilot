{
  "$defs": {
    "DocumentType": {
      "description": "The kinds of inbound document VoltDesk accepts. Closed set.",
      "enum": [
        "electricity_bill",
        "site_assessment",
        "email_thread"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "ExtractedField_PhaseConfiguration_": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "description": "Model-reported confidence, recalibrated by Phase 2's scorer. 0.0 means 'absent from the document', not 'uncertain'.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "source_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-indexed page the quote came from, for PDFs.",
          "title": "Source Page"
        },
        "source_quote": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verbatim span from the source document supporting the value. Required whenever value is not None; enforced by Phase 2's validator, not here, because the generic wrapper cannot see whether T is nullable.",
          "title": "Source Quote"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhaseConfiguration"
            },
            {
              "type": "null"
            }
          ],
          "description": "The extracted value, or None when the document does not state it."
        }
      },
      "required": [
        "value",
        "confidence"
      ],
      "title": "ExtractedField[PhaseConfiguration]",
      "type": "object"
    },
