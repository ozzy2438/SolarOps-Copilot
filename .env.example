# VoltDesk configuration. Copy to .env and fill in.
# Every variable here is read by voltdesk/config.py. Nothing else reads os.environ directly.

VOLTDESK_ENV=local
VOLTDESK_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# One PostgreSQL database, two schemas: `app` and `vec` (see migrations/0001_init.sql).
VOLTDESK_DATABASE_URL=postgresql+psycopg://voltdesk:voltdesk@localhost:5432/voltdesk

# --- Queue ----------------------------------------------------------------
VOLTDESK_REDIS_URL=redis://localhost:6379/0

# --- LLM providers --------------------------------------------------------
# Leave a key empty to disable that provider; the router will then treat it as unavailable.
VOLTDESK_ANTHROPIC_API_KEY=
VOLTDESK_OPENAI_API_KEY=

# --- EspoCRM --------------------------------------------------------------
VOLTDESK_ESPOCRM_BASE_URL=http://localhost:8080
# EspoCRM API-key authentication: an API user's key, sent as the X-Api-Key header.
VOLTDESK_ESPOCRM_API_KEY=
VOLTDESK_ESPOCRM_TIMEOUT_SECONDS=30

# --- Guardrails -----------------------------------------------------------
# Extractions at or above this confidence may auto-write to the CRM.
VOLTDESK_AUTO_WRITE_CONFIDENCE_THRESHOLD=0.85
# Below this, the field is dropped rather than queued (treated as "no signal").
VOLTDESK_REVIEW_FLOOR_CONFIDENCE=0.30
# Refuse to answer when retrieval support falls below this.
VOLTDESK_ABSTENTION_THRESHOLD=0.55
VOLTDESK_REDACTION_ENABLED=true
