# VoltDesk configuration. Copy to .env and fill in.
# Every variable here is read by voltdesk/config.py. Nothing else reads os.environ directly.

VOLTDESK_ENV=local
VOLTDESK_LOG_LEVEL=INFO

# --- Host ports -----------------------------------------------------------
# Only two services are published on your machine, because only two need to be
# reachable from it. PostgreSQL and Redis are NOT published at all: api and worker
# reach them over the Compose network at postgres:5432 and redis:6379, so a host
# port would buy nothing except a chance to collide with something else you run.
#
# Change these two if 8000 or 8080 are taken. Never stop the service that already
# holds a port - move VoltDesk instead.
VOLTDESK_API_HOST_PORT=8000
VOLTDESK_ESPOCRM_HOST_PORT=8080

# Host access to PostgreSQL and Redis is opt-in, via the overlay file:
#
#     docker compose -f docker-compose.yml -f docker-compose.hostports.yml up -d
#     docker compose port postgres 5432      # tells you the port Docker picked
#
# Left unset below, Docker assigns free ephemeral ports and nothing can collide.
# Pin them only if you have checked the port is free, and then point the URLs in the
# next section at the same numbers.
# VOLTDESK_POSTGRES_HOST_PORT=
# VOLTDESK_REDIS_HOST_PORT=

# --- Database -------------------------------------------------------------
# One PostgreSQL database, two schemas: `app` and `vec` (see migrations/0001_init.sql).
#
# Inside Compose this is supplied by the api and worker services as postgres:5432 and
# the value below is not used. It is here for running VoltDesk ON THE HOST - a local
# uvicorn, a test run, applying migrations by hand - against the Compose stack.
#
# It is commented out on purpose. A default pointing at localhost:5432 would connect
# to whatever PostgreSQL you already run, and applying VoltDesk's migrations there
# would create its schemas inside somebody else's database. Uncomment it only after
# `docker compose port postgres 5432` has told you the real port.
#
# For a one-off query you do not need any of this:
#     docker compose exec postgres psql -U voltdesk -d voltdesk
#
# VOLTDESK_DATABASE_URL=postgresql+psycopg://voltdesk:voltdesk@localhost:<port>/voltdesk

# --- Queue ----------------------------------------------------------------
# Same as above: supplied inside Compose, commented out here on purpose.
# VOLTDESK_REDIS_URL=redis://localhost:<port>/0

# --- LLM providers --------------------------------------------------------
# Leave a key empty to disable that provider; the router will then treat it as unavailable.
VOLTDESK_ANTHROPIC_API_KEY=
VOLTDESK_OPENAI_API_KEY=

# --- EspoCRM --------------------------------------------------------------
VOLTDESK_ESPOCRM_BASE_URL=http://localhost:8080
# EspoCRM API-key authentication: an API user's key, sent as the X-Api-Key header.
VOLTDESK_ESPOCRM_API_KEY=
VOLTDESK_ESPOCRM_TIMEOUT_SECONDS=30

# --- Guardrails -----------------------------------------------------------
# Extractions at or above this confidence may auto-write to the CRM.
VOLTDESK_AUTO_WRITE_CONFIDENCE_THRESHOLD=0.85
# Below this, the field is dropped rather than queued (treated as "no signal").
VOLTDESK_REVIEW_FLOOR_CONFIDENCE=0.30
# Refuse to answer when retrieval support falls below this.
VOLTDESK_ABSTENTION_THRESHOLD=0.55
VOLTDESK_REDACTION_ENABLED=true
