# VoltDesk configuration. Copy to .env and fill in.
# Every variable here is read by voltdesk/config.py. Nothing else reads os.environ directly.

VOLTDESK_ENV=local
VOLTDESK_LOG_LEVEL=INFO

# --- Host ports for the Compose stack -------------------------------------
# These publish the Compose services on your machine. They do NOT affect how the
# containers talk to each other - api and worker always reach the database at
# postgres:5432 over the Compose network, whatever you set here.
#
# The Postgres and Redis defaults are deliberately non-standard. A developer machine
# very often already runs PostgreSQL on 5432 or Redis on 6379, and VoltDesk must not
# compete for those ports. If you hit "port is already allocated", change the number
# here - never stop the other service.
VOLTDESK_POSTGRES_HOST_PORT=55432
VOLTDESK_REDIS_HOST_PORT=56379
VOLTDESK_API_HOST_PORT=8000
VOLTDESK_ESPOCRM_HOST_PORT=8080

# --- Database -------------------------------------------------------------
# One PostgreSQL database, two schemas: `app` and `vec` (see migrations/0001_init.sql).
#
# This URL is used when you run VoltDesk *on the host* (tests, migrations, a local
# uvicorn) against the Compose stack, so its port must match VOLTDESK_POSTGRES_HOST_PORT
# above. Inside Compose this value is overridden to postgres:5432.
#
# Note the port: pointing this at localhost:5432 would connect to whatever PostgreSQL
# you already have running, and applying VoltDesk's migrations there would create its
# schemas inside your existing database.
VOLTDESK_DATABASE_URL=postgresql+psycopg://voltdesk:voltdesk@localhost:55432/voltdesk

# --- Queue ----------------------------------------------------------------
# Must match VOLTDESK_REDIS_HOST_PORT above, for the same reason.
VOLTDESK_REDIS_URL=redis://localhost:56379/0

# --- LLM providers --------------------------------------------------------
# Leave a key empty to disable that provider; the router will then treat it as unavailable.
VOLTDESK_ANTHROPIC_API_KEY=
VOLTDESK_OPENAI_API_KEY=

# --- EspoCRM --------------------------------------------------------------
VOLTDESK_ESPOCRM_BASE_URL=http://localhost:8080
# EspoCRM API-key authentication: an API user's key, sent as the X-Api-Key header.
VOLTDESK_ESPOCRM_API_KEY=
VOLTDESK_ESPOCRM_TIMEOUT_SECONDS=30

# --- Guardrails -----------------------------------------------------------
# Extractions at or above this confidence may auto-write to the CRM.
VOLTDESK_AUTO_WRITE_CONFIDENCE_THRESHOLD=0.85
# Below this, the field is dropped rather than queued (treated as "no signal").
VOLTDESK_REVIEW_FLOOR_CONFIDENCE=0.30
# Refuse to answer when retrieval support falls below this.
VOLTDESK_ABSTENTION_THRESHOLD=0.55
VOLTDESK_REDACTION_ENABLED=true
